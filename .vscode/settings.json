{
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./pipeline", "-p", "test_*.py", "-t", "./pipeline"],
  "python.envFile": "${workspaceFolder}/.env",
  "terminal.integrated.env.windows": { "PYTHONUTF8": "1" },
  "terminal.integrated.env.osx": { "PYTHONUTF8": "1" },
  "terminal.integrated.env.linux": { "PYTHONUTF8": "1" },
  "files.exclude": { "**/__MACOSX": true, "**/.DS_Store": true, "**/__pycache__": true },
  "files.associations": { "*.jsonl": "jsonl" }
}
